# rustmush server configuration — copy to mushd.toml and edit.
# Keys marked (M2) are honored by the current server; keys marked
# (reserved) are documented targets for later milestones and are read but
# NOT yet honored — listed so operators aren't surprised. The "(hot)"
# / @reload story also lands later (M3+); today everything needs a restart.
#
# This file documents every section the server reads, for a LOCAL run. A
# DEPLOYED instance renders deploy/instance/mushd.toml.tmpl from an
# instance.env instead — same sections, real values, no defaults-by-omission.
# crates/mush-config/tests/shipped_configs.rs asserts the two declare the same
# section set, so a new section cannot land in one and be forgotten in the other.

[server]
name = "rustmush dev"              # (M2)
data_dir = "./data"                # (M2) host keys, logs (a leftover accounts.json is imported once)
help_dir = "./docs/help"           # (M3) markdown help topics served by "help <topic>" (missing dir = no topics)

[log]                              # (M9) structured logging + rotation
# level = "info"                   # (M9) tracing env-filter; empty = honor RUST_LOG, else "info".
#                                  #      e.g. "info,mush_llm=debug,mush_net_web=warn"
# format = "pretty"                # (M9) "pretty" (console) or "json" (one object/line, for log shipping)
# file = false                     # (M9) also write daily-rotating logs to <data_dir>/logs/ (mushd.log.YYYY-MM-DD)

[store]
store = "redis"                    # (M2) "redis" (authoritative) or "memory" (nothing survives restart)
redis_url = "redis://127.0.0.1:6379"   # (M2)
receipt_policy = "applied"         # "applied" or strict AOF-fsync "host_power_loss"

[store.archive]                    # (J5) the ledger archive tier: sealed log chunks to compressed disk
# enabled = false                  # attach the tier and run the nightly pass
# dir = "archive"                  # under [server].data_dir; back it up with the store — it is money
# window = "03:00-04:00"           # UTC; the copy, the verify and the purge run inside it, once a day
# retain_hours = 48                # never purge a chunk the archive copied less than this long ago
# high_watermark_mb = 512          # ledger bytes resident in the store that start a purge …
# low_watermark_mb = 256           # … and where it stops (oldest copies first, bounded per pass)
# segment_chunks = 256             # chunks per archive segment file
# max_purge_per_pass = 4096        # the most chunks one pass purges

[offers]                           # (K5) opaque legal-action offer signing
# key_dir = "./data/offer-keys"    # defaults to <server.data_dir>/offer-keys
# The server creates a private version-1 key on first boot. Rotation publishes
# a new immutable manifest while retaining at most three prior verification
# keys, so unchanged in-flight offers survive restart and bounded rotation.

[resolution]                       # (K4) authoritative resolution RNG
# key_dir = "./data/resolution-keys" # defaults to <server.data_dir>/resolution-keys
# This is a separate private key family: never point it at offer-keys. The
# server provisions it before writable boot; rulesets receive only a bounded
# per-action RNG capability and never receive these root bytes.

[ssh]
listen = "0.0.0.0:2222"            # (M2)

[ipc]                              # (M16b) forked gateway<->server boundary socket
listen = "127.0.0.1:6791"          #   mush-gateway connects here; mush-server binds it.
#                                  #   A localhost TCP address works everywhere (Windows too);
#                                  #   on Linux a filesystem path selects a Unix-domain socket,
#                                  #   e.g. listen = "/run/rustmush/ipc.sock".
#                                  #   The all-in-one `mushd` binary ignores this section.

[web]                              # (M4) HTTP + WebSocket client (mush-net-web)
listen = "127.0.0.1:8080"          # (M4) bind a public address or reverse-proxy to it
# trusted_proxies = ["127.0.0.1"]  # (M4) honor X-Forwarded-For from these proxies only
# tls = { cert = "cert.pem", key = "key.pem" }  # (M4) native TLS (needs the `tls`
#                                  # cargo feature; a reverse proxy is the usual prod setup)
# auth_burst = 5                   # (M4) /api/auth/* rate limit: burst ...
# auth_replenish_secs = 30         # (M4) ... and refill (one attempt per 30s per IP)
# metrics_enabled = false          # (M9) serve GET /metrics (Prometheus text). Default OFF (opt-in):
#                                  #      it binds this same (maybe public) listener with no auth,
#                                  #      so turn it on only behind your reverse proxy / firewall.
#                                  #      Exposes ONLY aggregate counters/gauges — never per-player
#                                  #      data or keys. GET /healthz is always served (ok/uptime/
#                                  #      version/connections/loop_lag_ms/world_loop_unixtime/store_ok).
# Note: `features` / `panels` are filled from the module registry at boot —
# do not set them here.

[discord]                          # (D1–D2) the Discord bot (mush-net-discord); off unless enabled
enabled = false
# token_env = "DISCORD_BOT_TOKEN"  # the env var holding the bot token — NEVER the token itself
# application_id = 0              # the bot's application id (required when enabled); 0 = read the env var below
# application_id_env = "DISCORD_APPLICATION_ID"
# guild_id = 0                    # the one guild it serves (relay + staff channels); 0 = read the env var below
# guild_id_env = "DISCORD_GUILD_ID"
# link_attempts_per_10m = 5       # failed /link attempts one Discord user may make per 10 min
# auto_follow_default = false     # what a new link's auto-follow starts as (D2)
# dm_coalesce_ms = 1500           # (D2) DM batching window
# dm_max_chars = 1900             # (D2) longest DM message
# dm_queue_lines = 2000           # (D2) coalescer buffer before the oldest narrative is dropped
# follow_idle_detach_s = 21600    # (D2) detach a follow after this idle (never while in a scene)
# staff_channel_id = 0            # (D5) the #staff channel; 0 disables
# [[discord.relay]]               # (D4) one per mirrored comsys channel
# channel = "Public"
# discord_channel_id = 0
# direction = "both"              # both | to_discord | to_game
# webhook = true                  # post game lines under the character's name

[game]
# Onboarding / chargen gating (chargen_required + start rooms) lives in its own
# [onboarding] section below — set it there, NOT here.
guest_pool = 5                     # (reserved — guest pool is M3+)
linkdead_grace_s = 300             # (M2)
max_characters = 3                 # (M2) per-account character cap (newchar)
ic_ratio = 1                       # (M5) IC seconds per OOC second (game-clock speed); 4 = an IC day every 6 real hours; read at boot
ic_epoch = "2020-01-01 00:00"      # (M5) IC datetime at OOC unix time 0 — the calendar's phase/start. "YYYY-MM-DD[ HH:MM[:SS]]".
#                                  # IC time is a pure function of real time (survives restarts); it is NOT reset to this at each boot.
starter_area = true                # (S1) apply the shipped starter area — the lot, the OOC Area <O> and the
#                                  # Staff lot <S> off Limbo — at a world's FIRST boot. Static content compiled
#                                  # into the server: no LLM call, ever. Never re-applied on a later boot; a
#                                  # pack staff retired stays retired. Set false for an empty Limbo.

# (M5) The scripting and weather modules are compiled in and always active.
# mush-script's sandbox budgets and mush-weather's tick/ambient knobs use
# built-in defaults; wiring the rest to config is a later step. The M10 weather
# flavor pool sizing IS configurable — see [weather] below. In-game: "help
# scripting" and "help weather".

[economy]                          # (E2+) the economy's limits; every key optional
# tx_tail_max = 20000              # (J2) newest journal transactions kept in RAM as full records;
#                                  #      older ones are read from the journal on demand (doc 12)
# checkpoint_every_entries = 10000 # (J3) journal entries between checkpoints; 0 writes none (doc 12)
# idempotency_window_secs = 2592000 # (W2) how long a posted key stays in RAM: a cache, every key is on
#                                  #      disk forever (doc 13); 30 days
# idempotency_window_max = 1000000 # (W2) at most this many keys in RAM, whichever bound is smaller

[weather]                          # (M10) weather LLM flavor top-up
# The deterministic Markov weather machine is unaffected by this; only the
# staff-reviewed GENERATED flavor-text pool sizing is tuned here.
# flavor_variants = 10             # (M10) how many variants @weather/generate requests per
#                                  #       (climate, state) bucket (transition + ambient). Each
#                                  #       is a cheap Ambience call; lines land PENDING and enter
#                                  #       play only after "@weather/lines/approve". In-game:
#                                  #       "help weather".

[worldgen]                         # (M10) batch @gen/building; (S3) the building agent
# batch_max_rooms = 40             # (M10) the @gen/building interior-walk cap: the most rooms one
#                                  #       batch describes (BFS from the entrance over interior
#                                  #       exits). A larger building is refused with a note. In-game:
#                                  #       "help worldgen".
# plan_cost_cap_usd = 5.0          # (S3) a proposal's cost cap: a planning run stops before the
#                                  #       call that would pass it, and what it has is kept.
# plan_cost_target_usd = 2.0       # (S3) the target the model is told to aim for; never enforced.
# plan_max_rounds = 6              # (S3) the most provider calls one planning run makes (1..=24).
# hydration_cap = 2                # (S3) a character's default cap on outstanding site requests
#                                  #       (+build/place); staff set one by hand with @atlas/cap.
# hydration_strikes_to_zero = 3    # (S3) strikes (@atlas/strike) at which a character's cap becomes
#                                  #       zero until staff reset it. In-game: "help build".

[rulesets]                         # (M6) which ruleset module loads
# Every ruleset crate is compiled into mushd; this list SELECTS which one
# registers. Registered after the built-in modules, so their commands (+roll,
# +sheet, +chargen, ...), panels, and approval job queues wire cleanly. Two
# rulesets are available: "wod" (oWoD20) and "shadowrun" (SR5). A server runs
# EXACTLY ONE — they share the +roll/+sheet/+chargen command names, so enabling
# two is a hard boot error. An unknown id is a hard boot error; an empty list
# runs a ruleset-less server. In-game: "help wod" / "help shadowrun".
enabled = ["wod"]                  # oWoD20; use ["shadowrun"] for Shadowrun 5e (SR5)
# The "wod" ruleset ships all four templates — Mortal, Vampire (V20), Mage
# (M20), Werewolf (W20). There is no per-splat allow-list: every template is
# selectable, and each player picks theirs during chargen with
# "+chargen/template <mortal|vampire|mage|werewolf>". A character is exactly one
# template, and its sheet carries only that splat's sections.

[wod.economy]                      # (E5c) the WoD ruleset's OWN economy layer
# Ruleset-owned (D-E5-9): these knobs turn the WoD layer on and off, never the
# E2-E4 economy the server runs regardless. "off" is the pre-E5c shape — housing
# works and staff create tenancies, but no character carries money. Read only
# when [rulesets].enabled names "wod"; harmless on a Shadowrun server, and
# written out anyway so the shipped example is the whole config surface.
personal_mode = "off"              # off | abstract | exact (an unknown word is a hard boot error)
housing = true                     # create tenancies + register system:wod.housing as title issuer
careers = true                     # evaluate careers, stances, opportunities, exposure
default_engagement = "ambient"     # ambient | engaged — a new profile's engagement
cadence = "chronicle.period"       # the economy cadence clock careers/abstract housing settle on
starting_funds_major = 0           # exact mode only: chargen starting funds, major units
reserved_rooms = []                # extra #N rooms that may never become property rooms

[shadowrun.economy]                # (E6a) the Shadowrun ruleset's OWN economy layer
# Ruleset-owned exactly as [wod.economy] is. Off by default: SR5 still rolls
# dice and nuyen is still a sheet number; the accounts, lifestyle billing and
# run board are what this switches. The verbs register either way and answer
# "not enabled on this server" when off.
enabled = false
instrument = "sr.nuyen"            # the currency code, registered at scale 0
lifestyle_clock = "sr.month"       # the declared cadence lifestyle is billed on
lifestyle = true                   # create lifestyle obligations
player_run_offers = true           # +run/post accepts a personal payer
organization_run_offers = true     # +run/post ... scope=<org> is accepted
vendor_orgs = []                   # org ids whose contract acceptance may be programmatic
active_offer_cap = 4               # per-principal open listings
board_ttl_secs = 1209600           # how long a listing lives (14 d)
board_cap = 128                    # the whole board's open-listing cap

[tacsim]                           # (E7 cut 1) the TacSim layer: packs, seeds, the corridor
# TacSim is a LAYER, not a ruleset id. It coexists with whichever single
# character ruleset [rulesets].enabled selects, and composes AFTER it, because
# it supplies physical and civil context rather than ruleset metaphysics: a
# ruleset decides what those facts mean to its characters. Off by default, and
# an off server is bit-identical to one built before E7 — the @tacsim verbs
# still register and answer "TacSim is not enabled on this server."
enabled = false
# Content packs, read HOST-SIDE at boot. Each entry is a .json pack file or a
# directory searched for *.json in sorted order. A file that cannot be read, is
# larger than 512 KiB, does not parse, has an unknown key, whose declared digest
# is not its content's, or whose `requires` is unsatisfied is a HARD BOOT ERROR
# NAMING THE FILE — a pack is the operator's declared intent, and a typo is
# better refused at boot than discovered at first use.
pack_paths = []                    # rules-definition packs (immutable, digest-referenced)
seed_paths = []                    # campaign-seed packs (applied to the world ONCE)
corridor = ""                      # which seed pack "@tacsim/seed" applies by default
# Parsed and INERT until later E7 cuts; listed here so the block is written once.
active_domain_limit = 8            # cut 6's MAX_ACTIVE_DOMAINS
ground_pulse_ms = 2000             # cut 8's ground pulse period
space_pulse_ms = 6000              # cut 8's space pulse period

[tacsim.time]                      # the campaign's rate and catch-up POLICY
# Every key here is parsed and inert until cuts 4/8/11, and NONE of it seeds the
# world timeline: generation one comes from [game].ic_ratio/ic_epoch, and
# persisted truth wins thereafter. This is campaign policy, not a clock.
rate = 0                           # IC seconds per real second the campaign intends
catch_up_journeys = ""             # cut 6
catch_up_production = ""           # cut 4
catch_up_fronts = ""               # cut 9
catch_up_domains = ""              # cut 8

[tacsim.recovery]                  # (E7r1 R4) the recovery provider: a lost-everything loaner
# Off by default; @recovery still registers and answers "not enabled on this
# server". Like [tacsim] itself this block is deny_unknown_fields — a mistyped
# key REFUSES the boot rather than taking a default, because it decides who gets
# rescued and on what terms, and a policy the operator believes is in force and
# is not is worse than not starting. It does NOT need [tacsim].enabled: the
# provider is campaign-shaped, not tacsim-shaped.
# The pool is NEVER minted into. pool_account names an ordinary account the
# provider organization already holds; a deployment that wants to subsidize it
# writes a staff-authored system obligation, outside this block.
enabled = false
pool_account = 0                   # the budget account; 0 is unwired — an enabled provider then queues and pages
pool_floor = 0                     # the balance the pool may not be granted below: funded, never infinite
tiers = []                         # the loaner tier table, cheapest first; an enabled provider needs one
applications_per_principal = 1     # live applications one principal may hold
cooldown_days = 14                 # 10b §7's RECOVERY_COOLDOWN, under every insurance word
max_operational_assets = 0         # eligibility threshold over ACCESSIBLE assets (an unreachable wreck qualifies)
insurance = "approved_operations"  # approved_operations | none — debt vs write-off, and nothing else
upkeep_per_period = 0              # the lease's rent obligation, per campaign cadence period

[tacsim.economy]                   # (16b cut R-b) the one game's economy wiring
# Replaces [wod.economy] and [shadowrun.economy]. `housing` keeps the tenancy
# title issuer (system:tacsim.housing) registered so @property/create can mint;
# `market` registers the market's title issuer and composes the market (no
# catalog sources until the game authors some); `instrument` is the settlement
# currency the game registers at first boot (doc 11 §2: the credit, "cr"), at
# scale 2. Like [tacsim] this block is deny_unknown_fields.
housing = true
market = false
instrument = "tacsim.credit"
reserved_rooms = []                # extra rooms (#N) that may never become property rooms, beside [onboarding]'s two

[onboarding]                       # (M9) the chargen_required gate + start rooms
# When off (the default), a fresh character plays immediately, exactly as
# before. When on, a newly created, not-yet-approved character is placed in the
# chargen area, dropped into the guided wizard on connect ("+chargen/wizard"),
# and held to a restricted command set (chargen / look / say / help; channel
# speech and movement are gated) until a storyteller approves its wod-chargen
# job; approval then moves it to the live start room and grants full access.
# Room ids are object numbers (#N).
# chargen_required = false          # gate unapproved characters behind approval
# start_room = 0                    # live start room approved characters land in (#0 = Limbo)
# start_room_unapproved = 0         # restricted chargen area (defaults to start_room)

[atlas]                            # (S1) the spatial layer: map tiles and the content pack shelf
# Every key defaults. deny_unknown_fields, like [tacsim] and [npc]: a typo
# refuses the boot rather than taking a default.
tile_max_cells = 65536             # the most cells one map tile holds (256x256); larger footprints rasterize coarser
nearest_room_cells = 8             # (S4) how far, in cells, a pose may stand off every room's footprint and still count as in the nearest
# (S4) Tactical windows: the ground a window takes around a scene's rooms, in
# metres, and the most cells one window holds -- past it the map coarsens to the
# next registered cell size (100 -> 200 -> 500 -> 1000 cm) rather than refusing.
window_margin_m = 10
window_max_cells = 65536
# Content packs, read HOST-SIDE at boot exactly like [tacsim].pack_paths: each
# entry is a .json pack file or a directory searched for *.json in sorted order,
# and one that cannot be read, does not parse, or whose declared digest is not
# its content's is a HARD BOOT ERROR NAMING THE FILE. Listed packs go on the
# shelf "@atlas/pack list|plan|apply" works from; nothing is applied by being
# listed here. The shipped starter packs are always on the shelf.
pack_paths = []
# (S2) Travel on the world clock. A passage's legs are IC seconds; real time is
# IC over the campaign rate. dwell_floor_s keeps a traveler at every checkpoint
# at least this many REAL seconds so a stake-out can act; real_cap_s caps a whole
# passage in real seconds per travel mode (a mode not listed is uncapped -- ship
# and torch campaigns set their own).
dwell_floor_s = 30
[atlas.real_cap_s]
foot = 180
car = 180
transit = 180
bus = 180

[npc]                              # (H2b) the NPC agent layer's world-task knobs
# How long an NPC's scene turn may wait for its durable decision before the
# idle fallback fires, seconds. Every key here defaults; an unknown key refuses
# to boot, like every other typed section.
scene_turn_deadline_secs = 120

[llm]                              # (M7) LLM layer: worldgen (@gen), budgets, kill switch
# Master switch. FALSE by default so a keyless clone boots and passes tests;
# worldgen commands still register, but @gen answers "LLM features are
# disabled." Flip to true once at least one provider below has its API key in
# the environment (see keys note under [llm.providers]).
enabled = false
# (H2a) How many delayed-decision provider workers the world task runs for
# NPC decisions. 1..=32; the default is 8. Independent of [llm.concurrency].
decision_workers = 8

# --- Providers -------------------------------------------------------------
# Two wire protocols. Routing is by the MODEL-ID PREFIX on each route below,
# NOT by naming a provider here: a model id "anthropic/<model>" goes to the
# provider registered as `anthropic` (prefix stripped); ANY other model id
# (e.g. "z-ai/glm-5.3") goes to the provider registered as `openrouter`,
# verbatim. So keep these two ids exactly as written.
#
# API keys are NEVER inlined here. Each provider names an ENV VAR
# (`api_key_env`); mushd reads it at boot and never logs the value. In dev,
# mushd loads a `.env` in the working directory (real env vars win); in prod,
# set real env vars (ANTHROPIC_API_KEY / OPENROUTER_API_KEY). A provider whose
# key env-var is unset is skipped — any route to it then fails fast with a
# clear staff-visible error, so a clone with only one key still runs the
# routes it can serve.

[llm.providers.openrouter]
kind = "openai"                    # OpenAI-compatible chat-completions wire
base_url = "https://openrouter.ai/api/v1"
api_key_env = "OPENROUTER_API_KEY"
requests_per_minute = 60           # per-provider QPS ceiling (governor)
referer = "https://github.com/rustmush"   # OpenRouter attribution (HTTP-Referer)
title = "rustmush"                 # OpenRouter attribution (X-Title)

[llm.providers.anthropic]
kind = "anthropic"                 # Anthropic Messages API (prompt-cached lore)
base_url = "https://api.anthropic.com"
api_key_env = "ANTHROPIC_API_KEY"
requests_per_minute = 60
anthropic_version = "2023-06-01"
# Anthropic has no per-call cost field, so cost is ESTIMATED as tokens x these
# per-MTok prices (OpenRouter reports real usage.cost instead — no estimate).
price_input_per_mtok = 5.0
price_output_per_mtok = 25.0

# --- Feature routes --------------------------------------------------------
# Each LLM feature maps to one route (route name == feature key). A route sets
# the model, an output-token ceiling, a timeout, and the reasoning effort.
# THESE ARE REASONING MODELS: max_tokens must leave headroom for reasoning
# tokens on top of the visible output, or the answer comes back empty. The
# starter models below are the user's validated OpenRouter set.

[llm.routes.worldgen_room]         # @gen here=<prose> — single-room draft
model = "z-ai/glm-5.3"
max_tokens = 1500                  # room desc + reasoning headroom
timeout_s = 90
reasoning = "low"                  # low | medium | high | off

[llm.routes.worldgen_brief]        # whole-building brief (M10 seam; route reserved now)
model = "z-ai/glm-5.3-flash"
max_tokens = 2000
timeout_s = 120
reasoning = "low"

[llm.routes.worldgen_plan]         # (S3) the building agent: @atlas/propose and +build/place turn a
model = "z-ai/glm-5.3"             #       brief into a content pack over a bounded tool loop. A strong
max_tokens = 8000                  #       model, high effort: the validator, not the prompt, is the
timeout_s = 180                    #       guarantee, but a weak model burns rounds on refusals.
reasoning = "high"

[llm.routes.ambience]              # weather/ambient flavor (M10)
model = "deepseek/deepseek-v4-flash-0731"
max_tokens = 400
timeout_s = 30
reasoning = "off"                  # deepseek: reasoning disabled -> clean short output

# --- NPC dialogue routes (M8) ----------------------------------------------
# One route per NPC tier, plus the memory-fold route. The agent layer picks a
# route from each NPC's tier (set with `@agent/set <npc>/tier=<major|minor|
# extra>`): Major = named, plot-relevant NPCs; Minor = recurring background;
# Extra = throwaway. Cost preference: keep the whole default NPC pipeline on
# OpenRouter's cheap reasoning/flash models. anthropic/claude-opus-5 (Anthropic
# direct, prompt-cached) is RESERVED for a critical NPC you deliberately
# promote — swap the npc_dialogue_major model line for it and keep reasoning
# "low"; leave the others alone.
#
# Per-tier cooldowns (minimum seconds between LLM turns) default in code —
# Major 5s / Minor 15s / Extra 60s — and are overridable per NPC with
# `@agent/set <npc>/cooldown=<seconds>`. An NPC alone in a room costs zero
# tokens (no connected player ⇒ no wake).

[llm.routes.npc_dialogue_major]    # named, plot-relevant NPCs (short cooldown)
model = "z-ai/glm-5.3"             # promote a hero NPC -> "anthropic/claude-opus-5"
max_tokens = 1024
timeout_s = 30
reasoning = "low"

[llm.routes.npc_dialogue_minor]    # recurring background NPCs
model = "z-ai/glm-5.3-flash"
max_tokens = 1024
timeout_s = 30
reasoning = "low"

[llm.routes.npc_dialogue_extra]    # throwaway NPCs (cheapest, long cooldown)
model = "deepseek/deepseek-v4-flash-0731"   # same cheap model as [ambience]
max_tokens = 768
timeout_s = 30
reasoning = "off"                  # deepseek: reasoning off -> clean short output

[llm.routes.npc_decision]          # (H2a) one durable NPC decision: one tool call
model = "z-ai/glm-5.3-flash"       # the model picks exactly one projected action
max_tokens = 512
timeout_s = 30
reasoning = "low"
# Without this route every NPC decision falls back to its idle action after
# its deadline (the same degrade shape as dialogue with [llm].enabled = false).

[llm.routes.npc_summarize]         # NPC memory fold (cheap, background)
model = "z-ai/glm-5.3-flash"
max_tokens = 768
timeout_s = 60
reasoning = "off"

# --- Storyteller adjudication routes (M13) ---------------------------------
# The LLM Storyteller for freeform Mage workings (+cast <effect> proposing
# <spheres>). st_adjudicate JUDGES the proposal (strong model — rulings are
# rules calls); st_interpret narrates the engine's already-thrown result
# (cheaper — pure prose over an authoritative outcome). The LLM never rolls and
# never sets the result; the engine rolls, logs, re-validates, and clamps.

[llm.routes.st_adjudicate]         # judge a proposed working -> structured ruling
model = "z-ai/glm-5.3"
max_tokens = 1024
timeout_s = 45
reasoning = "low"

[llm.routes.st_interpret]          # narrate the engine's logged outcome
model = "z-ai/glm-5.3-flash"
max_tokens = 768
timeout_s = 30
reasoning = "off"

# --- Concurrency -----------------------------------------------------------
[llm.concurrency]
max_interactive = 8                # dialogue + single-room worldgen in flight
max_background = 3                 # batch gen / summarization / ambience

# --- Budgets (daily, UTC rollover) -----------------------------------------
# Every layer that applies must pass a pre-call check; any layer may cap
# tokens, cost (USD), or both. OpenRouter cost is real (usage.cost);
# Anthropic cost is estimated from the per-MTok prices above.
[llm.budgets]
global = { tokens = 5_000_000, cost_usd = 5.0 }   # server-wide/day
per_actor_default = { cost_usd = 1.0 }            # per builder/day (BUILDER_LLM quota)
per_npc_default = { tokens = 200_000 }            # per NPC/day (any one agent's ceiling)

[llm.budgets.per_feature]
worldgen_room = { cost_usd = 2.0 }
worldgen_plan = { cost_usd = 20.0 }   # (S3) every planning run on the server, per day; a single
#                                      #      proposal is capped by [worldgen].plan_cost_cap_usd
# Cap the whole NPC dialogue pipeline (all tiers share nothing but this key is
# per-route; add npc_dialogue_minor / npc_dialogue_extra similarly if desired).
npc_dialogue_major = { cost_usd = 1.0 }

# --- Reliability (optional; sane defaults shown) ---------------------------
# [llm.retry]                      # min_delay_ms=500 max_delay_ms=30000 factor=2.0 max_retries=3 jitter=true
# [llm.circuit_breaker]            # consecutive_failures=5 open_secs=60
