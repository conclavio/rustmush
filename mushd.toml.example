# rustmush server configuration — copy to mushd.toml and edit.
# Keys marked (hot) can be reloaded at runtime with @reload; others need a restart.

[server]
name = "rustmush dev"
data_dir = "./data"            # host keys, accounts.json (M1-interim), logs

[store]
redis_url = "redis://127.0.0.1:6379"

[ssh]
listen = "0.0.0.0:2222"

[web]
listen = "127.0.0.1:8080"
# tls_cert = ""                # native TLS optional; reverse proxy recommended in prod
# tls_key = ""
# trusted_proxies = ["127.0.0.1"]

[game]
start_room = 0                 # Limbo
guest_pool = 5
chargen_required = false
linkdead_grace_s = 300
ic_time_ratio = 1              # IC hours per OOC hour

[rulesets]
enabled = ["wod"]

[llm]
enabled = false                # flip on with keys configured (M7+)
# [llm.providers.anthropic]
# kind = "anthropic"
# api_key = { env = "ANTHROPIC_API_KEY" }
# [llm.routes.worldgen_room]   # (hot)
# provider = "anthropic"
# model = "claude-opus-5"
