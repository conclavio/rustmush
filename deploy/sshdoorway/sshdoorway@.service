# sshdoorway generation %i (a or b) — doc 29 §9-§10.
# Two generations alternate: swap.sh starts the idle one, waits for READY=1,
# then sends SIGUSR1 to the active one, which drains (warnings at 12h, 6h, 2h,
# 1h, 15m, 1m remaining; closes at 24 h or when empty). A draining generation
# leaves /var/lib/sshdoorway/draining-%i, so a crash-restart does not bring it
# back into service beside its successor; swap.sh clears it.
[Unit]
Description=sshdoorway (port-22 SSH front door), generation %i
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=sshdoorway
Group=sshdoorway
ExecStart=/opt/rustmush/sshdoorway/sshdoorway --config /etc/rustmush/sshdoorway.toml --generation %i
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM means FINISH: stop accepting, one 30 s warning, close, exit. So a
# plain stop/restart, needrestart or a reboot never becomes a 24 h drain.
# The 24 h drain is SIGUSR1, sent only by swap.sh once a successor is
# serving; it does not change the unit's state, so swap.sh's two-generation
# guard sees both. (Adversarial review H2/H3.)
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=120
Restart=on-failure
RestartSec=2

# Port 22 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/sshdoorway /var/log/sshdoorway
StateDirectory=sshdoorway
StateDirectoryMode=0700

# journald gets warn and above only; this caps a storm (doc 29 §8.1).
LogRateLimitIntervalSec=30s
LogRateLimitBurst=200

LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
