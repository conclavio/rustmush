[Unit]
Description=Redis for the VPS gate runner (127.0.0.1:6799; wiped by every sweep)
Documentation=file:/home/ghrunner/actions-runner/_work/rustmush/rustmush/deploy/vps-runner/provision.sh
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /etc/redis/redis-gate.conf
User=redis
Group=redis
RuntimeDirectory=redis-gate
StateDirectory=redis-gate
UMask=007
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
