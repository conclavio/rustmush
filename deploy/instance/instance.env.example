# rustmush instance parameters — the WoD + TacSim reference instance.
#
# Copy to `instance.env`, edit, and render deploy/instance/mushd.toml.tmpl with
# it (the recipe is in the template's header). Every `__KEY__` in the template
# is one KEY below; a rendered config still containing `__` means a key is
# missing here, and crates/mush-config/tests/shipped_configs.rs says so.
#
# This file is ALSO the systemd EnvironmentFile shape's neighbour, not its
# replacement: secrets (OPENROUTER_API_KEY, ANTHROPIC_API_KEY, DISCORD_BOT_TOKEN)
# live in /opt/rustmush/<instance>/<instance>.env at root:mush 0640 and are never
# written here or into the rendered mushd.toml.

# --- identity ----------------------------------------------------------------
INSTANCE=dev3
INSTANCE_TITLE=rustmush dev3 (oWoD)

# --- paths (the unit's WorkingDirectory tree) --------------------------------
DATA_DIR=/opt/rustmush/dev3/data
BUILD_DIR=/opt/rustmush/dev3/build

# --- ports ------------------------------------------------------------------
# Pick a fresh, contiguous block per instance: dev1 = 6788/6789/6790,
# dev2 = 6791/6792/6793. REDIS_PORT is this instance's OWN Redis, never the
# box's 6379 development instance. SSH_PORT and WEB_PORT must be opened in BOTH
# ufw AND the hosting provider's network ACL; REDIS_PORT must be in neither.
EXTERNAL_IP=203.0.113.10
REDIS_PORT=6794
SSH_PORT=6795
WEB_PORT=6796

# --- the web listener's shape --------------------------------------------------
# WEB_BIND is the address `[web].listen` binds (the port is WEB_PORT). WEB_TLS is
# the WHOLE `tls = { ... }` line of the `[web]` table — the render drops it in
# as a line, so it may also be a `# comment`, which is how an instance leaves
# the key out and serves plain HTTP. WEB_TRUSTED_PROXIES is the TOML array of
# reverse-proxy addresses whose X-Forwarded-For is believed.
#
# This reference instance TERMINATES TLS ITSELF: the external address, the
# deploy's self-signed cert/key under /opt/rustmush/<instance>/tls, no trusted
# proxies — so WEB_PORT is the public HTTPS port. The gateway (or mushd) must be
# built with `--features tls`. A box with a TLS-terminating reverse proxy on it
# renders the other shape instead, which is what deploy/dev1/instance.env and
# deploy/dev2/instance.env do (Caddy in front; see deploy/README.md → "Behind
# Caddy"):
#
#   WEB_BIND=127.0.0.1
#   WEB_TLS=# no native tls: Caddy terminates TLS and proxies plain HTTP here
#   WEB_TRUSTED_PROXIES=["127.0.0.1"]
#
# Never combine a public WEB_BIND with a non-empty WEB_TRUSTED_PROXIES that
# names a public address, and never list an address that is not the proxy's own:
# a listed peer is believed about who the client is.
WEB_BIND=203.0.113.10
WEB_TLS=tls = { cert = "/opt/rustmush/dev3/tls/cert.pem", key = "/opt/rustmush/dev3/tls/key.pem" }
WEB_TRUSTED_PROXIES=[]

# The gateway<->server boundary. A per-instance Unix socket under the gateway
# unit's `RuntimeDirectory=rustmush` (/run/rustmush, mode 0750). Never a TCP
# port: the boundary is unauthenticated, and a localhost port both invites
# impersonation and can collide with REDIS_PORT.
IPC_SOCKET=/run/rustmush/dev3.sock

# Doc 29: the sshdoorway trusted ingress socket this gateway serves (a symlink
# gateway-swap.sh owns, next to the generations' own <inst>.<gen>.sock). Empty
# means no doorway on this box.
TRUSTED_SOCKET=

# --- logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- game ------------------------------------------------------------------
# The game's layer (packs, seeds, the corridor; 16b cut R-b) AND the switch that
# instantiates the simulator (16b cut F.4): the proving ground, its domain and
# the twelve stock tanks are its boot packs, so with this false the centre's pods
# have nothing behind them and SIM refuses. On here: this is the instance that
# wants the campaign/tactical layer.
TACSIM_ENABLED=true

# The IC clock. IC_RATIO is IC seconds per real second (1 = real time; 4 = an
# IC day every six real hours) and IC_EPOCH the IC date and time the clock reads
# at unix 0, YYYY-MM-DD HH:MM, without quotes (the template quotes it). Today's
# IC date is IC_EPOCH plus IC_RATIO times the seconds since 1970 — at ratio 1
# and this epoch a boot in 2026 reads 2076 — so the ratio moves today's date
# too. The world's timeline is seeded from these two only on an EMPTY store —
# the first boot writes generation one and persisted truth wins from then on —
# so an edit here changes nothing on a standing world until it is wiped
# (scripts/reset-instance.sh, which restarts on the rendered mushd.toml the last
# deploy wrote: change these, deploy, THEN wipe). Nothing but the config sets
# the epoch: there is no verb for it. These are the values the template used to
# hard-code.
IC_RATIO=1
IC_EPOCH=2020-01-01 00:00

# Onboarding. START_ROOM / START_ROOM_UNAPPROVED are OBJECT NUMBERS, and they
# must name rooms the world you boot ACTUALLY HAS. #0 is Limbo (the bootstrap
# room seeded beside God #1) and is not a place to open a game. A fresh store
# seeds Limbo and God and NOTHING ELSE today, so #2 and #3 are the ids the two
# rooms you dig before opening will take — not rooms you get for free. Dig them,
# then check (`look #2`, `examine #3` as God) before letting anyone connect; a
# start_room that names no object lands new characters nowhere. WS25-S5 is where
# the seed itself grows a start room and a chargen area.
CHARGEN_REQUIRED=true
START_ROOM=2
START_ROOM_UNAPPROVED=3

# --- The named launch and the dev-box switches (doc 44 cut MW.1) ----------------
# MINDS_LAUNCH is `on` or `off`. It is not a `__TOKEN__`: deploy/instance/render.sh
# reads it and decides whether the template's commented `[tacsim.minds]`
# `launch_path` line is rendered live. On, the line names <DATA_DIR>/launch.json
# and is live ONLY once that document exists; until then, and after a reset has
# wiped it with the data directory, the render is the same as off. That is what
# lets a deploy land on a fresh store with the switch on: the document names
# organisations, accounts, rooms and characters only a booted world has made, and
# a live path with no file refuses the boot. deploy/instance/launch-bringup.py
# makes them, writes the document and renders again (deploy/README.md, "Named
# launch and the player market"). Off, the world composes no mind commerce.
MINDS_LAUNCH=off

# The Registry's pulse in milliseconds ([tacsim.minds].registry_pulse_ms, doc 44
# Q-44-41), also read by render.sh. Empty leaves the template's commented line
# alone, which is the server's 1000: a rating takes about three hours. A dev box
# that is wiped and brought up again sets 50, and a rating takes minutes.
REGISTRY_PULSE_MS=

# The raid director ([tacsim.field].raid_director, doc 36 cut GC.11): true has
# the surface tick seed, launch and declare the content's raiders on their
# schedules; false leaves raiders to staff (@field/raiders).
RAID_DIRECTOR=false

# --- LLM --------------------------------------------------------------------
# True only once at least one provider's key env var is actually set in the
# unit's EnvironmentFile; a keyless instance with this true has routes that fail
# fast rather than features that work.
LLM_ENABLED=true

# --- The picture (doc 21 G.1b) ------------------------------------------------
# [pixel] diagnostics, box-wide: a player-facing box: players never see the diagnostics.
PIXEL_DIAGNOSTICS=false
