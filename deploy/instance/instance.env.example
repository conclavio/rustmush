# rustmush instance parameters — the WoD + TacSim reference instance.
#
# Copy to `instance.env`, edit, and render deploy/instance/mushd.toml.tmpl with
# it (the recipe is in the template's header). Every `__KEY__` in the template
# is one KEY below; a rendered config still containing `__` means a key is
# missing here, and crates/mush-config/tests/shipped_configs.rs says so.
#
# This file is ALSO the systemd EnvironmentFile shape's neighbour, not its
# replacement: secrets (OPENROUTER_API_KEY, ANTHROPIC_API_KEY, DISCORD_BOT_TOKEN)
# live in /opt/rustmush/<instance>/<instance>.env at root:mush 0640 and are never
# written here or into the rendered mushd.toml.

# --- identity ----------------------------------------------------------------
INSTANCE=dev3
INSTANCE_TITLE=rustmush dev3 (oWoD)

# --- paths (the unit's WorkingDirectory tree) --------------------------------
DATA_DIR=/opt/rustmush/dev3/data
BUILD_DIR=/opt/rustmush/dev3/build
TLS_DIR=/opt/rustmush/dev3/tls

# --- ports ------------------------------------------------------------------
# Pick a fresh, contiguous block per instance: dev1 = 6788/6789/6790,
# dev2 = 6791/6792/6793. REDIS_PORT is this instance's OWN Redis, never the
# box's 6379 development instance. SSH_PORT and WEB_PORT must be opened in BOTH
# ufw AND the hosting provider's network ACL; REDIS_PORT must be in neither.
EXTERNAL_IP=203.0.113.10
REDIS_PORT=6794
SSH_PORT=6795
WEB_PORT=6796

# The gateway<->server boundary. A per-instance Unix socket under the gateway
# unit's `RuntimeDirectory=rustmush` (/run/rustmush, mode 0750). Never a TCP
# port: the boundary is unauthenticated, and a localhost port both invites
# impersonation and can collide with REDIS_PORT.
IPC_SOCKET=/run/rustmush/dev3.sock

# --- logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- game ------------------------------------------------------------------
# Exactly one character ruleset: wod | shadowrun.
RULESET=wod
# The Shadowrun money layer follows RULESET: enabling nuyen on a WoD box would
# register a currency nothing spends.
SHADOWRUN_ECONOMY=false
# TacSim is a layer beside the character ruleset, not a third ruleset. On here:
# this is the instance that wants the campaign/tactical layer.
TACSIM_ENABLED=true

# Onboarding. START_ROOM / START_ROOM_UNAPPROVED are OBJECT NUMBERS and must
# name rooms the world actually has: #0 is Limbo (the bootstrap room seeded
# beside God #1) and is not a place to open a game. #2 and #3 are the first two
# ids a freshly seeded store hands out, which is what the instance seed creates
# them as — re-point these if your seed differs.
CHARGEN_REQUIRED=true
START_ROOM=2
START_ROOM_UNAPPROVED=3

# --- LLM --------------------------------------------------------------------
# True only once at least one provider's key env var is actually set in the
# unit's EnvironmentFile; a keyless instance with this true has routes that fail
# fast rather than features that work.
LLM_ENABLED=true
