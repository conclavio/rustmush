# rustmush instance parameters — the Shadowrun (SR5) instance.
#
# The same nineteen keys as instance.env.example, differing only where the game
# does: a different ruleset, its money layer on, and TacSim off. It is shipped
# so the template is exercised in BOTH of its per-instance shapes — a template
# only ever rendered one way is a template with one untested branch.
#
# Copy to `instance.env` and render deploy/instance/mushd.toml.tmpl with it.

# --- identity ----------------------------------------------------------------
INSTANCE=dev4
INSTANCE_TITLE=rustmush dev4 (SR5)

# --- paths (the unit's WorkingDirectory tree) --------------------------------
DATA_DIR=/opt/rustmush/dev4/data
BUILD_DIR=/opt/rustmush/dev4/build
TLS_DIR=/opt/rustmush/dev4/tls

# --- ports ------------------------------------------------------------------
EXTERNAL_IP=203.0.113.10
REDIS_PORT=6797
SSH_PORT=6798
WEB_PORT=6799

IPC_SOCKET=/run/rustmush/dev4.sock

# --- logging ----------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- game ------------------------------------------------------------------
RULESET=shadowrun
# Nuyen accounts, lifestyle billing and the run board: the point of an SR5 box.
SHADOWRUN_ECONOMY=true
# Off here. TacSim composes beside any ruleset, but this instance does not want
# the campaign layer, and the section is written rather than omitted so that
# fact is a decision on the page instead of a default nobody read.
TACSIM_ENABLED=false

# The same rule as instance.env.example: these ids must exist in the world you
# boot. A fresh store seeds only Limbo #0 and God #1, so dig #2/#3 before you
# open, or re-point these at the rooms your seed made.
CHARGEN_REQUIRED=true
START_ROOM=2
START_ROOM_UNAPPROVED=3

# --- LLM --------------------------------------------------------------------
LLM_ENABLED=true
