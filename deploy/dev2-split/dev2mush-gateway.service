[Unit]
Description=rustmush dev2 (TacSim) — the GATEWAY half (SSH 6792 + web 6793) in front of dev2mush-server
# The server unit is WANTED, never required (doc 33 §4.2): a server that is
# down or crash-looping must not take the gateway — and every player
# connection it holds — down with it. The gateway serves its "restarting"
# notice and keeps dialing until the server is back.
After=network-online.target redis-dev2mush.service dev2mush-server.service
Wants=network-online.target dev2mush-server.service
Requires=redis-dev2mush.service
Documentation=file:/opt/rustmush/dev2/build/deploy/dev2-split/README.md

[Service]
Type=simple
User=mush
Group=mush
# The trusted ingress (doc 29) accepts a doorway connection before the
# instance's own per-IP cap is applied at Hello, and the systemd default of
# 1024 descriptors is below sshdoorway's global cap (2048): an EMFILE burst
# must not starve the public port (doc 29a section 7, round 2).
LimitNOFILE=65536
WorkingDirectory=/opt/rustmush/dev2
# No EnvironmentFile: the LLM keys in dev2.env belong to dev2mush-server
# (doc 33 GG.1). The gateway makes no LLM call and reads nothing from them.
#
# The GATEWAY owns the SSH + WEB (HTTPS :6793) connections and DIALS the
# server at [ipc].listen, read from the same rendered mushd.toml the server
# binds it from. It does not start, stop or restart the server: that is
# systemd's job (`systemctl restart dev2mush-server`), and a server that is
# down is a gap the gateway rides out holding every connection, not a reason
# to exit. Booted with no server up, it binds its listeners and waits.
# The gateway binary must be built with `--features tls` to serve HTTPS here.
ExecStart=/opt/rustmush/dev2/build/target/release/mush-gateway --config /opt/rustmush/dev2/mushd.toml
# No ExecReload: SIGHUP is reserved (doc 33 §4.5) — logged at info and
# otherwise ignored. A deploy of the SERVER half is
# `systemctl restart dev2mush-server` (connections held, players see
# "restarting" then "Reconnected"); a deploy of the GATEWAY half is
# `systemctl restart dev2mush-gateway` (GATEWAY_RESTART=1 in deploy.sh), which
# drops every connection once.
#
# Restart the gateway only if the gateway itself dies (that DOES drop players:
# it owns the SSH + web sockets). A server death never reaches here.
Restart=on-failure
RestartSec=5
# One process now, with no child to sweep: systemd's default KillMode
# (control-group) and stop timeout are right. `systemctl stop dev2mush-gateway`
# stops ONLY the gateway; the server keeps running under its own unit. (Until
# doc 33 GG.2 the server still exits when the boundary closes and its unit
# brings it straight back.)

# No RuntimeDirectory: /run/rustmush-dev2 and the socket in it belong to
# dev2mush-server.service. Connecting to a unix socket needs no write access
# to its directory, so the read-only /run that ProtectSystem=strict leaves
# this service is enough.

# Hardening: the service needs only its own tree, the loopback Redis and the
# two sockets it reaches. Every path the RENDERED mushd.toml has the gateway
# write to is inside the one ReadWritePaths tree: the data dir and, under it,
# logs/ (gateway.log) — provisioned by deploy.sh.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/rustmush/dev2
# Doc 29: the trusted-ingress socket sshdoorway connects to ([ssh].trusted_socket).
# The "-" keeps the unit starting on a box without the directory (tmpfiles
# deploy/sshdoorway/sshdoorway.conf creates it setgid, group sshdoorway).
# Never RuntimeDirectory= for it: that would reset the setgid bit and remove
# the directory when the unit stops.
ReadWritePaths=-/run/rustmush-ssh

[Install]
WantedBy=multi-user.target
