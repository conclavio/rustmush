[Unit]
Description=rustmush dev1 (TacSim) MUSH server — SSH 6789, HTTPS 6790
After=network-online.target redis-dev1mush.service
Wants=network-online.target
Requires=redis-dev1mush.service
Documentation=file:/opt/rustmush/dev1/build/deploy/README.md

[Service]
Type=simple
User=mush
Group=mush
# The trusted ingress (doc 29) accepts a doorway connection before the
# instance's own per-IP cap is applied at Hello, and the systemd default of
# 1024 descriptors is below sshdoorway's global cap (2048): an EMFILE burst
# must not starve the public port (doc 29a section 7, round 2).
LimitNOFILE=65536
WorkingDirectory=/opt/rustmush/dev1
# LLM API keys (ANTHROPIC_API_KEY / OPENROUTER_API_KEY). root-owned, mode 640,
# injected by systemd — the mush user never reads the file, keys never logged.
EnvironmentFile=/opt/rustmush/dev1/dev1.env
ExecStart=/opt/rustmush/dev1/build/target/release/mushd --config /opt/rustmush/dev1/mushd.toml
Restart=on-failure
RestartSec=5

# Hardening: the service needs only its own tree + the loopback Redis. Every
# path the RENDERED mushd.toml writes to is inside that one tree — the data dir
# and, under it, logs/, archive/ (the J5 ledger tier), offer-keys/,
# resolution-keys/, geology-keys/ and quarantine/ — all provisioned by deploy.sh, so
# ProtectSystem=strict has nothing else to let through.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/rustmush/dev1
# Doc 29: the trusted-ingress socket sshdoorway connects to ([ssh].trusted_socket).
# The "-" keeps the unit starting on a box without the directory (tmpfiles
# deploy/sshdoorway/sshdoorway.conf creates it setgid, group sshdoorway).
# Never RuntimeDirectory= for it: that would reset the setgid bit and remove
# the directory when the unit stops.
ReadWritePaths=-/run/rustmush-ssh

[Install]
WantedBy=multi-user.target
