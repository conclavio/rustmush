# rustmush dev1 instance parameters — the box at conclav.io.
#
# dev1 RENDERS deploy/instance/mushd.toml.tmpl from this file. It used to keep a
# hand-written mushd.toml of its own, which predated the template and omitted
# ten of its sections — [log], [store.archive], [offers], [resolution],
# [discord], [economy], [weather], [worldgen], [onboarding], [npc] — so the box
# quietly ran each of them on a compiled-in default nobody chose: no log files,
# no ledger archive tier, key directories nobody provisioned. That file is gone;
# this one and the shared template replace it.
#
# Both deploy scripts (deploy/dev1/deploy.sh, the all-in-one; and
# deploy/dev1-split/deploy.sh, the hot-restartable split this box runs) install
# a copy of THIS file at /opt/rustmush/dev1/instance.env with the EXTERNAL_IP
# line resolved, render /opt/rustmush/dev1/mushd.toml beside it with
# deploy/instance/render.sh, and preflight the result with the binaries' own
# --check-config before any unit is started or reloaded. The installed copy is
# also what `scripts/reset-instance.sh /opt/rustmush/dev1/instance.env --yes`
# reads when the world is wiped.
#
# Secrets are never here: OPENROUTER_API_KEY / ANTHROPIC_API_KEY live in
# /opt/rustmush/dev1/dev1.env at root:mush 0640, injected by systemd into the
# gateway and inherited by the server child.

# --- identity ----------------------------------------------------------------
INSTANCE=dev1
INSTANCE_TITLE=rustmush dev1 (TacSim)

# --- paths (the unit's WorkingDirectory tree) --------------------------------
DATA_DIR=/opt/rustmush/dev1/data
BUILD_DIR=/opt/rustmush/dev1/build

# --- ports ------------------------------------------------------------------
# dev1's block is 6788/6789/6790. REDIS_PORT is this instance's OWN Redis, never
# the box's 6379 development instance. SSH_PORT is open in BOTH ufw and the
# Hostinger network ACL; WEB_PORT is open in NEITHER since the box went behind
# Caddy (it is bound on loopback, see below); REDIS_PORT is in neither.
#
# EXTERNAL_IP is `auto`, which is not an address: it is the marker both deploy
# scripts replace with the source IP of the box's default route (the public
# IPv4, never the tailscale address, which is not the default route) when they
# install this file on the box. The box's address is not a fact about the
# repository, and a committed address is one nobody notices has gone stale — so
# it is resolved at deploy time and only ever written into the installed copy.
EXTERNAL_IP=auto
REDIS_PORT=6788
SSH_PORT=6789
WEB_PORT=6790

# --- the web listener: behind Caddy ----------------------------------------------
# Caddy on this box (/etc/caddy/Caddyfile, deploy/caddy/Caddyfile) owns 80/443,
# terminates TLS for dev1.conclav.io and proxies plain HTTP to 127.0.0.1:6790.
# So the gateway's web listener binds LOOPBACK, serves no TLS of its own (WEB_TLS
# is a comment line: the `tls` key is left out of the rendered [web] table), and
# believes X-Forwarded-For from the one peer that is Caddy — without that last
# line every web client would be 127.0.0.1 to the IP guard, and one address
# would carry every ban and every auth rate-limit bucket. The deploy's
# self-signed cert under /opt/rustmush/dev1/tls is no longer read by anything.
# deploy/README.md → "Behind Caddy" is the on-box procedure this shape pairs
# with (Caddyfile upstream, ufw, the Hostinger ACL).
WEB_BIND=127.0.0.1
WEB_TLS=# no native tls: Caddy terminates TLS for this box and proxies plain HTTP here
WEB_TRUSTED_PROXIES=["127.0.0.1"]

# The gateway<->server boundary: a per-instance Unix socket under the gateway
# unit's `RuntimeDirectory=rustmush` (/run/rustmush, mode 0750). Never a TCP
# port — the boundary is unauthenticated, so a localhost port would let any
# local process impersonate the gateway.
IPC_SOCKET=/run/rustmush/dev1.sock

# Doc 29: the sshdoorway trusted ingress socket this gateway serves (a symlink
# gateway-swap.sh owns, next to the generations' own <inst>.<gen>.sock). Empty
# means no doorway on this box.
TRUSTED_SOCKET=/run/rustmush-ssh/dev1.sock

# --- logging ----------------------------------------------------------------
LOG_LEVEL=info
# `pretty`, not the template's `json`. Both formats reach journald and both are
# written to <DATA_DIR>/logs/ ([log].file is on in the template); the difference
# is who reads them. `json` is the choice for a box with a log shipper, which
# needs the fields intact. dev1 has no shipper: its operator reads
# `journalctl -u dev1mush-gateway -f` by eye, and the human format is the one
# that can be read that way. `pretty` and `json` are the only two values
# `mush_config::config::LogCfg::format` knows; anything else degrades to
# `pretty` with a warning on stderr rather than refusing the boot.
LOG_FORMAT=pretty

# --- game ------------------------------------------------------------------
# The switch that instantiates the simulator (16b cut F.4): the proving ground,
# its domain and the twelve stock tanks are the game's boot packs and ride on
# this flag. This is the box the simulator centre is played on, so it is on.
TACSIM_ENABLED=true

# The IC clock (16c T-88; the owner's word of 2026-09-26): four IC seconds a real
# second, and the IC date the clock reads at unix 0 — NOT the date the clock
# starts at. Today's IC date is that epoch plus four times the seconds since
# 1970, so the epoch below was computed for the wipe of 2026-09-26 21:11 UTC to
# make dev1's fresh world open on 2350-01-01, the game's year; it gains four IC
# days a real day from there. A wiped world is seeded with these, and after that
# only another wipe moves the epoch (a hand edit of the rendered file does not
# survive a deploy; this file does). The box's installed copy carries the same.
IC_RATIO=24
IC_EPOCH=0987-04-20 06:00

# Onboarding — and this box differs from the reference instance on purpose.
#
# The reference instance gates chargen and starts characters in two rooms an
# operator digs before opening. dev1 does neither, because:
#
#   * it boots the shipped starter area ([game].starter_area = true in the
#     template), and that area's entrance hangs off Limbo itself: the
#     `neighborhood.ooc_area` pack's `exit.limbo_welcome` runs `from: limbo` to
#     the Welcome Hall under the names `OOC Area <O>;o;ooc`, and the Welcome
#     Hall's `exit.hall_simulator_lobby` is the door to the Simulator Lobby and
#     its two pod rooms. A character standing in #0 is one `ooc` away from the
#     tutorial rooms and two from a pod, so there is nothing to dig;
#   * there is no approval staff on a playtest box. `chargen_required = true`
#     holds every new character in the chargen area until a storyteller
#     approves them, and on dev1 there is no storyteller to do it;
#   * and this exact shape is a documented no-op rather than a hole:
#     `mush_core::OnboardingConfig`'s all-default form — `chargen_required`
#     false, both rooms Limbo — is written up in
#     `crates/mush-core/src/onboarding.rs` as "the gate always passes, the hook
#     never fires, the spawn move is a no-op, and approval moves no one —
#     exactly the pre-onboarding behaviour".
#
# So both ids are 0 (Limbo), which the store seeds beside God #1 on every fresh
# world; unlike #2/#3 they are ids this box actually has on first boot.
CHARGEN_REQUIRED=false
START_ROOM=0
START_ROOM_UNAPPROVED=0

# --- LLM --------------------------------------------------------------------
# The box has its provider keys in /opt/rustmush/dev1/dev1.env, and the
# template's [llm.budgets] cap what they can spend.
LLM_ENABLED=true

# --- The picture (doc 21 G.1b) ------------------------------------------------
# [pixel] diagnostics, box-wide: dev1 is the playtest box: the picture as a player sees it.
PIXEL_DIAGNOSTICS=false
