[Unit]
Description=Redis for rustmush dev1 (127.0.0.1:6788)
After=network.target
Documentation=file:/opt/rustmush/dev1/build/deploy/dev1/README.md

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /etc/redis/redis-dev1mush.conf
User=redis
Group=redis
RuntimeDirectory=redis-dev1mush
StateDirectory=redis-dev1mush
UMask=007
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
