[Unit]
Description=Redis for rustmush dev1 (/run/redis-dev1mush/redis.sock)
After=network.target
Documentation=file:/opt/rustmush/dev1/build/deploy/dev1/README.md

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /etc/redis/redis-dev1mush.conf
User=redis
Group=mush
SupplementaryGroups=redis
RuntimeDirectory=redis-dev1mush
RuntimeDirectoryMode=0750
StateDirectory=redis-dev1mush
StateDirectoryMode=0700
UMask=007
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
