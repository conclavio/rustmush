[Unit]
Description=rustmush dev2 (SR5) MUSH server — SSH 6792, HTTPS 6793
After=network-online.target redis-dev2mush.service
Wants=network-online.target
Requires=redis-dev2mush.service
Documentation=file:/opt/rustmush/dev2/build/deploy/dev2/README.md

[Service]
Type=simple
User=mush
Group=mush
WorkingDirectory=/opt/rustmush/dev2
# LLM API keys (ANTHROPIC_API_KEY / OPENROUTER_API_KEY). root-owned, mode 640,
# injected by systemd — the mush user never reads the file, keys never logged.
EnvironmentFile=/opt/rustmush/dev2/dev2.env
ExecStart=/opt/rustmush/dev2/build/target/release/mushd --config /opt/rustmush/dev2/mushd.toml
Restart=on-failure
RestartSec=5

# Hardening: the service needs only its own tree + the loopback Redis.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/rustmush/dev2

[Install]
WantedBy=multi-user.target
