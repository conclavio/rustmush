+    let sight = mush_tactics::ComponentId::new("visual_sensor").expect("component");
+    assert_eq!(assessment.component_conditions[&sight], ComponentCondition::Damaged,
+        "building a hull must not repair an input part for free; input={sight_lot:?}");
+}
