+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn review_72h_yard_keeps_a_used_parts_condition() {
+    use mush_tactics::field_ops::{ComponentCondition, ProvenanceLegalityStatus};
+    use tacsim::port::bay_work::act::{BayActHandles, PartOrigin, PartProvenance, Stripped};
+    let mut rig = stocked();
+    let captain = review_72h_captain(&mut rig);
+    let order = booked(&mut rig, captain, "+yard/order tv_escort");
+    let bill = contract(&rig, order).bill;
+    let mut lot = 99_000;
+    let mut sight_lot = None;
+    let (parent_hull, parent_schema) = rig.tw.world().module_state::<mush_tactics::UnitStore>()
+        .expect("units").units.iter()
+        .find(|(_, unit)| unit.schema().key().id.as_str() == "tacsim.unit.tv_escort")
+        .map(|(hull, unit)| (*hull, unit.schema().clone())).expect("seed escort source");
+    for line in bill {
+        if tacsim::port_tick::is_part(&line.good) {
+            seed_lot(&mut rig, VaultId(order), line.good.as_str(), 1, LotId(lot));
+            let damaged = line.good.as_str() == "tacsim.part.sensor.visual_mk1";
+            let definition = store(&rig.tw).definitions().parts.values()
+                .find(|part| part.commodity == line.good).expect("catalogued part").row.clone();
+            let row = PartProvenance {
+                lot: LotId(lot), definition,
+                condition: if damaged { ComponentCondition::Damaged } else { ComponentCondition::Intact },
+                legality: ProvenanceLegalityStatus::CleanTitle,
+                fitted_into: None,
+                origin: if damaged { PartOrigin::Stripped(Stripped {
+                    parent_hull, parent_schema: parent_schema.clone(),
+                    slot: mush_tactics::ComponentId::new("visual_sensor").expect("slot"),
+                    claim: None, stripped_by: captain, stripped_at_ic: ic_now(&rig.tw),
+                    scrapped: false,
+                }) } else { PartOrigin::Seeded { receipt: format!("review-used-part-{lot}") } },
+            };
+            let family = rig.tw.world().module_state::<BayActHandles>().expect("bay handles").parts.clone();
+            let prepared = {
+                let mut txn = rig.tw.engine_mut().action_transaction(&family).expect("part transaction");
+                txn.insert(&family, &LotId(lot), row).expect("seed provenance");
+                txn.prepare().expect("prepare provenance")
+            };
+            let (ops, install) = prepared.into_parts();
+            rig.tw.engine_mut().install_prepared_action(install).expect("install provenance");
+            crate::driving_rig::keep(&mut rig, ops);
+            if damaged { sight_lot = Some(LotId(lot)); }
+        } else {
+            seed_pool(&mut rig, VaultId(order), line.good.as_str(), line.units, LotId(lot));
+        }
+        lot += 1;
+    }
+    settle(&mut rig, 2);
+    days_on(&mut rig, 2);
+    let _ = typed_in(&mut rig, captain, &format!("+yard/collect {order}"), 4);
+    let hull = commission(&rig, order).object().expect("commissioned hull");
+    let unit = mush_tactics::module::unit_of(rig.tw.world(), hull).expect("unit");
