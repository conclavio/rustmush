    "lore.the_lot": {
      "kind": "lore",
      "def": {
        "tag": "the_lot",
        "entries": [
          {
            "tier": "public",
            "subject": "the lot",
            "fact": "The lot is a working film studio: the OOC Area by the south gate, the Staff Lobby in the north-east, and the studio tour bus looping between them."
          },
          {
            "tier": "public",
            "subject": "the tour bus",
            "fact": "The studio tour bus runs from the OOC bus stop past the security gate and the water tower to the lobby forecourt, and back."
          },
          {
            "tier": "public",
            "subject": "the open house",
            "fact": "Once a week the back-lot coffee shop holds an open house; Susie from the lobby plays her own songs there."
          },
          {
            "tier": "public",
            "subject": "staff",
            "fact": "The people in the Staff Lobby are staff: ask them, they like being asked."
          }
        ]
      }
    }
