[registry revocation: identity strings]
capability = roll.registry.revoke
command = @mindrevoke
family roll_registry_term_revocations owner = roll
family roll_registry_term_revocations record FAMILY = roll_registry_term_revocations
family roll_registry_term_revocations key codec = roll_registry_term_revocations.key.v1
family roll_registry_term_revocations value schema = roll_registry_term_revocations.value.v1
family roll_registry_term_revocations schema version = 1
family roll_registry_term_revocations decoder = roll_registry_term_revocations.strict_decode.v1
family roll_registry_term_revocations validator = roll_registry_term_revocations.invariants.v1
family roll_registry_term_revocations serializer = roll_registry_term_revocations.canonical.v1
family roll_registry_term_revocations max key bytes = 192
family roll_registry_term_revocations max record bytes = 32768
family roll_registry_term_revocations record MAX_BYTES = 32768
family roll_registry_revoked_terms owner = roll
family roll_registry_revoked_terms record FAMILY = roll_registry_revoked_terms
family roll_registry_revoked_terms key codec = roll_registry_revoked_terms.key.v1
family roll_registry_revoked_terms value schema = roll_registry_revoked_terms.value.v1
