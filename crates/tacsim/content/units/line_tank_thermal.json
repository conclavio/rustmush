  "entries": {
    "tacsim.unit.line_tank_thermal": {
      "kind": "unit",
      "def": {
        "label": "line tank (thermal)",
        "sections": [
          {
            "id": "hull",
            "facets": [
              { "id": "front", "armor": 400 },
              { "id": "left", "armor": 250 },
              { "id": "right", "armor": 250 },
              { "id": "rear", "armor": 150 },
              { "id": "top", "armor": 100 }
