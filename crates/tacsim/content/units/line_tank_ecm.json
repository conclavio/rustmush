              "sensor": "tacsim.sensor.ecm_mk1"
            }
          },
          {
            "id": "power",
            "section": "hull",
            "role": {
              "kind": "power",
              "capability": "tacsim.power",
              "states": ["off", "starting", "online"],
              "initial": "off"
            }
          },
          {
            "id": "core",
            "section": "turret",
            "role": {
              "kind": "core",
              "core": "tacsim.core.line"
            }
          }
        ],
        "mobility": {
          "tracked": {
            "max_speed_cms": 1500,
            "accel_cms2": 100,
            "brake_cms2": 200,
            "turn_rate_mdeg_s": 30000,
            "reverse_factor_pct": 50
          }
        },
        "facets": [
          {
            "band": "front",
            "sections": [
              { "section": "hull", "weight": 50 },
              { "section": "turret", "weight": 50 }
            ]
          },
          {
            "band": "left",
            "sections": [
              { "section": "hull", "weight": 40 },
              { "section": "left_track", "weight": 30 },
              { "section": "turret", "weight": 30 }
            ]
          },
          {
            "band": "right",
            "sections": [
              { "section": "hull", "weight": 40 },
              { "section": "right_track", "weight": 30 },
              { "section": "turret", "weight": 30 }
            ]
          },
          {
            "band": "rear",
            "sections": [
              { "section": "hull", "weight": 40 },
              { "section": "engine", "weight": 30 },
              { "section": "turret", "weight": 30 }
            ]
          },
          {
            "band": "top",
            "sections": [
              { "section": "hull", "weight": 50 },
              { "section": "turret", "weight": 50 }
            ]
          }
        ],
        "silhouettes": [
          { "band": "front", "width_cm": 350, "height_cm": 250 },
          { "band": "left", "width_cm": 700, "height_cm": 250 },
          { "band": "right", "width_cm": 700, "height_cm": 250 },
          { "band": "rear", "width_cm": 350, "height_cm": 250 },
          { "band": "top", "width_cm": 700, "height_cm": 350 }
        ],
        "sensor_height_cm": 150,
        "note": "The line tank with doc 16 section 9 item 4's jamming pod bolted to the hull and nothing else touched: the same five sections, the same armour, the same facet table, the same silhouettes, the same tracked mode, the same two guns and the same Mk1 visual sight, so a match against a stock tank is a match about the pod. On the HULL and not the turret for a reason: the hull's consequence is destroy_unit, so the one hit that stops the pod radiating is the one that makes the tank a wreck, and the arena reads the wreck it already reads. The pod's three numbers live on the sensor row it names (tacsim.sensor.ecm_mk1) and reach the arena as cells on this component; role ecm rather than a second role sensor because a pod is not something the tank SEES with, and a second sensor mount would shadow the sight the tank aims by. Version 2 (16b cut M.4): both tracks carry the pair rule. Version 3 (17b cut M3.1): a line core in the turret. Version 4 (17b cut M3.6): losing the turret destroys its core."
      }
    }
