  "entries": {
    "tacsim.unit.line_tank_ecm": {
      "kind": "unit",
      "def": {
        "label": "line tank (ECM)",
        "sections": [
          {
            "id": "hull",
            "facets": [
              { "id": "front", "armor": 400 },
              { "id": "left", "armor": 250 },
              { "id": "right", "armor": 250 },
              { "id": "rear", "armor": 150 },
              { "id": "top", "armor": 100 }
            ],
            "internals": 200,
            "consequences": [{ "kind": "destroy_unit" }]
          },
          {
            "id": "turret",
            "facets": [
              { "id": "front", "armor": 350 },
              { "id": "left", "armor": 220 },
              { "id": "right", "armor": 220 },
              { "id": "rear", "armor": 140 }
            ],
            "internals": 150,
            "consequences": [
              { "kind": "remove_weapons", "section": "turret" },
              { "kind": "destroy_core" }
            ]
          },
          {
            "id": "left_track",
            "facets": [{ "id": "left", "armor": 120 }],
            "internals": 100,
            "consequences": [
              { "kind": "slow", "percent": 50 },
              { "kind": "no_turn_toward", "side": "left" },
              { "kind": "disable_motion_when_all_of", "sections": ["left_track", "right_track"] }
            ]
          },
          {
            "id": "right_track",
            "facets": [{ "id": "right", "armor": 120 }],
            "internals": 100,
            "consequences": [
              { "kind": "slow", "percent": 50 },
              { "kind": "no_turn_toward", "side": "right" },
              { "kind": "disable_motion_when_all_of", "sections": ["left_track", "right_track"] }
            ]
          },
          {
            "id": "engine",
            "facets": [],
            "internals": 120,
            "consequences": [{ "kind": "disable_motion" }],
            "struck_through": { "section": "hull", "facet": "rear" }
          }
        ],
        "components": [
          {
            "id": "cannon",
            "section": "turret",
            "role": {
              "kind": "weapon",
              "weapon": "tacsim.weapon.cannon_105",
              "coaxial": false
            }
          },
          {
            "id": "machine_gun",
            "section": "turret",
            "role": {
              "kind": "weapon",
              "weapon": "tacsim.weapon.mg_coax",
              "coaxial": true
            }
          },
          {
            "id": "visual_sensor",
            "section": "turret",
            "role": {
              "kind": "sensor",
              "sensor": "tacsim.sensor.visual_mk1"
            }
