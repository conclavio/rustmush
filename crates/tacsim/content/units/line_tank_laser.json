            "section": "turret",
            "role": {
              "kind": "core",
              "core": "tacsim.core.line"
            }
          }
        ],
        "mobility": {
          "tracked": {
            "max_speed_cms": 1500,
            "accel_cms2": 100,
            "brake_cms2": 200,
            "turn_rate_mdeg_s": 30000,
            "reverse_factor_pct": 50
