              { "section": "right_track", "weight": 30 },
              { "section": "turret", "weight": 30 }
            ]
          },
          {
            "band": "rear",
            "sections": [
              { "section": "hull", "weight": 40 },
              { "section": "engine", "weight": 30 },
              { "section": "turret", "weight": 30 }
            ]
          },
          {
            "band": "top",
            "sections": [
              { "section": "hull", "weight": 50 },
              { "section": "turret", "weight": 50 }
            ]
          }
        ],
        "silhouettes": [
          { "band": "front", "width_cm": 350, "height_cm": 250 },
          { "band": "left", "width_cm": 700, "height_cm": 250 },
          { "band": "right", "width_cm": 700, "height_cm": 250 },
          { "band": "rear", "width_cm": 350, "height_cm": 250 },
          { "band": "top", "width_cm": 700, "height_cm": 350 }
        ],
        "sensor_height_cm": 150,
        "heat_max": 60,
        "heat_dissipation_per_s": 3,
        "note": "The line tank with the 105 swapped for the Mk1 laser, and nothing else touched: the same five sections, the same armour, the same facet table, the same silhouettes, the same tracked mode, the same coaxial and the same sight, so a match between the two is a match between the weapons. The two numbers cut X.1 adds are the ones the swap needs. 60 is three pulses of the laser's 20, which is what makes the third shot the one that locks the turret out rather than the first. 3 a second empties that ceiling in twenty seconds, so a tank that fires its three and waits is firing about one pulse every seven seconds sustained, against the cannon's six-second cycle. Version 2 (16b cut M.4): both tracks carry disable_motion_when_all_of, so a tank with no tracks neither drives nor turns. Version 3 (17b cut M3.1): a line core in the turret. Version 4 (17b cut M3.6): losing the turret destroys its core."
      }
