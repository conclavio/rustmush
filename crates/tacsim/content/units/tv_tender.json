          "rooms": [
            {
              "desc": "A one-seat cab under a scratched canopy, the seat empty and its harness clipped back. Where a driver's hands would rest a teleoperation repeater blinks green, carrying the bridge's commands down the link and the rig's cameras back up it. A stores gauge sits by the canopy frame, and an Occator Water & Propellant lease tag is riveted under it. Behind the seat a tow hitch's control box is bolted to the bulkhead, its plate stamped RECOVERY. The air is thin and cold and smells of grease.",
              "details": {
                "hitch box": "A recovery hitch's controls: a heavier coupling than a prospector's, rated to three times the rig's own mass.",
                "repeater": "A sealed box with a green link light and a red one. Green means the bridge has the rig; red means nobody does, and the rig sits still until somebody does.",
                "seat": "Empty, its harness clipped back. A stencil on the headrest says CREW SEAT; rigs like this one are driven from the bridge.",
                "stores gauge": "Tonnes and cubic metres in the stores bin against its two limits, 2.7 t and 4.8 m3, and a second dial for the opened bale's alloys and fittings, in kilograms."
              },
              "id": "cab",
              "kind": "walkable",
              "name": "Cab",
              "short_desc": "One empty seat behind a scratched canopy, a repeater blinking where the hands would go, a stores gauge by the frame."
            },
            {
              "desc": "The stores bin behind the cab where a prospector carries its hopper: racked crates of rounds, a tonne of alloy bar and a tonne of yard fittings under a strapped tarpaulin. Not a place anyone walks.",
              "id": "stores",
              "kind": "store",
              "name": "Stores"
            }
          ],
          "space": "cab",
          "store": "stores"
        },
        "label": "Tender terrain vehicle",
