          "rooms": [
            {
              "desc": "Two seats side by side high over the tracks, under a canopy ribbed against falling rock. Between them a winch console carries the coupling's load cells, a tension dial and a big red release under a hinged guard. A teleoperation repeater sits beside the console for the days the crawler is driven from the lifter's bridge. Every panel wears the Tycho Mutual roundel and a fleet number. The air is cold and smells of hydraulic oil.",
              "details": {
                "repeater": "A sealed box with a green link light and a red one: green, the lifter has the crawler; red, the crew in the seats does.",
                "roundel": "TYCHO MUTUAL ASSURANCE & SALVAGE, CERES, and a fleet number under it.",
                "winch console": "The heavy coupling's controls: load cells, a tension dial, and a release under a guard. The plate reads RATED TWICE OWN MASS, LADEN CASUALTY."
              },
              "id": "cab",
              "kind": "walkable",
              "name": "Cab",
              "short_desc": "Two seats high over the tracks, a winch console between them, the Tycho Mutual roundel on every panel."
            },
            {
              "desc": "A locker under the cab: chain, shackles, cutting gear and a tonne of blocking timber. Not a place anyone walks.",
              "id": "stores",
              "kind": "store",
              "name": "Stores"
            }
          ],
          "space": "cab",
          "store": "stores"
        },
        "label": "Tycho recovery crawler",
