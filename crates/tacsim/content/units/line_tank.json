  "entries": {
    "tacsim.unit.line_tank": {
      "kind": "unit",
      "def": {
        "label": "line tank",
        "sections": [
          {
            "id": "hull",
            "facets": [
              { "id": "front", "armor": 400 },
              { "id": "left", "armor": 250 },
              { "id": "right", "armor": 250 },
              { "id": "rear", "armor": 150 },
              { "id": "top", "armor": 100 }
            ],
            "internals": 200,
            "consequences": [{ "kind": "destroy_unit" }]
          },
          {
            "id": "turret",
            "facets": [
              { "id": "front", "armor": 350 },
              { "id": "left", "armor": 220 },
              { "id": "right", "armor": 220 },
              { "id": "rear", "armor": 140 }
            ],
            "internals": 150,
            "consequences": [
              { "kind": "remove_weapons", "section": "turret" },
              { "kind": "destroy_core" }
            ]
          },
          {
            "id": "left_track",
            "facets": [{ "id": "left", "armor": 120 }],
            "internals": 100,
            "consequences": [
              { "kind": "slow", "percent": 50 },
              { "kind": "no_turn_toward", "side": "left" },
              { "kind": "disable_motion_when_all_of", "sections": ["left_track", "right_track"] }
            ]
          },
          {
            "id": "right_track",
            "facets": [{ "id": "right", "armor": 120 }],
            "internals": 100,
            "consequences": [
              { "kind": "slow", "percent": 50 },
              { "kind": "no_turn_toward", "side": "right" },
              { "kind": "disable_motion_when_all_of", "sections": ["left_track", "right_track"] }
            ]
          },
          {
            "id": "engine",
            "facets": [],
            "internals": 120,
            "consequences": [{ "kind": "disable_motion" }],
            "struck_through": { "section": "hull", "facet": "rear" }
          }
        ],
        "components": [
          {
            "id": "cannon",
            "section": "turret",
            "role": {
              "kind": "weapon",
              "weapon": "tacsim.weapon.cannon_105",
              "coaxial": false
            }
          },
          {
            "id": "machine_gun",
            "section": "turret",
            "role": {
              "kind": "weapon",
              "weapon": "tacsim.weapon.mg_coax",
              "coaxial": true
            }
          },
          {
            "id": "visual_sensor",
            "section": "turret",
            "role": {
              "kind": "sensor",
              "sensor": "tacsim.sensor.visual_mk1"
            }
          },
          {
            "id": "power",
            "section": "hull",
            "role": {
              "kind": "power",
              "capability": "tacsim.power",
              "states": ["off", "starting", "online"],
              "initial": "off"
            }
          },
          {
            "id": "core",
            "section": "turret",
            "role": {
              "kind": "core",
              "core": "tacsim.core.line"
            }
          }
        ],
        "mobility": {
          "tracked": {
            "max_speed_cms": 1500,
            "accel_cms2": 100,
            "brake_cms2": 200,
            "turn_rate_mdeg_s": 30000,
            "reverse_factor_pct": 50
          }
        },
        "facets": [
          {
            "band": "front",
            "sections": [
              { "section": "hull", "weight": 50 },
              { "section": "turret", "weight": 50 }
            ]
          },
          {
            "band": "left",
            "sections": [
              { "section": "hull", "weight": 40 },
              { "section": "left_track", "weight": 30 },
              { "section": "turret", "weight": 30 }
            ]
          },
          {
            "band": "right",
            "sections": [
              { "section": "hull", "weight": 40 },
              { "section": "right_track", "weight": 30 },
              { "section": "turret", "weight": 30 }
            ]
          },
          {
            "band": "rear",
            "sections": [
              { "section": "hull", "weight": 40 },
              { "section": "engine", "weight": 30 },
              { "section": "turret", "weight": 30 }
            ]
          },
          {
            "band": "top",
            "sections": [
              { "section": "hull", "weight": 50 },
              { "section": "turret", "weight": 50 }
            ]
          }
        ],
        "silhouettes": [
          { "band": "front", "width_cm": 350, "height_cm": 250 },
          { "band": "left", "width_cm": 700, "height_cm": 250 },
          { "band": "right", "width_cm": 700, "height_cm": 250 },
          { "band": "rear", "width_cm": 350, "height_cm": 250 },
          { "band": "top", "width_cm": 700, "height_cm": 350 }
        ],
        "sensor_height_cm": 150,
        "note": "The five sections, their facets, their components and the tracked mode are doc 16 section 3.3's table verbatim; sensor_height_cm 150 and the five mobility numbers are doc 16's and the brief's. Everything else is cut C's. The armour reads front-heavy and thin behind on purpose: 400 front hull against 150 rear hull is what makes the facet-attribution table of section 3.3 a tactical fact rather than a formality, and 120 on each track against 400 on the front is why a flank shot is worth manoeuvring for. The default facet table of section 3.3 is authored literally: front to hull and turret, rear to hull, engine and turret, a side to hull, that side's track and the turret, top to hull and turret. The silhouettes are a real tank's box: 3.5 m across the bow, 7 m down the flank, 2.5 m tall, 3.5 m presented from above. Version 2 (16b cut M.4): both tracks carry the pair rule. Version 3 (17b cut M3.1): a line core in the turret. Version 4 (17b cut M3.6): losing the turret destroys its core."
      }
