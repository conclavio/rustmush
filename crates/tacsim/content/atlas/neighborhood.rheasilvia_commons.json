    "room.pad": {
      "kind": "room",
      "def": {
        "name": "Rheasilvia Commons Pad",
        "short_desc": "A cleared landing square on the ridged floor of Rheasilvia basin on Vesta, the ground dark and metallic.",
        "desc": "The pad is a cleared square of fused dust with tie-down rings sunk at its edges and the Registry number FR-V1 painted in its centre. Beyond the square the floor of Rheasilvia is ridged and broken, dark rock showing through a thin dust that has a faint metallic sheen in hard light. The ground slopes so gently it reads as flat, and the horizon is close in every direction. The basin's great central peak is beyond it, out of sight.",
        "surface": "ground",
        "footprint": {
          "rect": [
            [
              1260,
              1260
            ],
            [
              1300,
              1300
            ]
          ]
        },
        "kind": "outdoor",
        "markers": [
          "port.dock"
        ],
        "details": {
          "dark rock": "Basalt and metal-rich breccia from Vesta's interior, laid bare when the basin was dug. It is heavy in the hand.",
          "ridges": "Long low ridges running across the basin floor, each a few metres high. The pad was set between two of them."
        }
      }
    },
