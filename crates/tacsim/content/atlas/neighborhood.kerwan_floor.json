    "room.pad": {
      "kind": "room",
      "def": {
        "name": "Kerwan Floor Pad",
        "short_desc": "A cleared landing square on the smooth floor of Kerwan basin, the ground dark and stony.",
        "desc": "The pad is a cleared square of packed regolith with tie-down rings at its edges and the Registry number FR-14 stencilled in its centre. The ground around it is darker than the Freeport's, a thin grey dust over stony ground that crunches under a boot. Kerwan's floor runs flat to a horizon only a few kilometres off; its old rim is too far and too worn to stand above it. Small fresh craters pock the plain, each with a bright apron of thrown rock.",
        "surface": "ground",
        "footprint": {
          "rect": [
            [
              1260,
              1260
            ],
            [
              1300,
              1300
            ]
          ]
        },
        "kind": "outdoor",
        "markers": [
          "port.dock"
        ],
        "details": {
          "registry stake": "A survey stake beside the pad marks the site's centre: a steel post with a brass cap, the site's name and its coordinates stamped in.",
          "thrown rock": "Angular blocks sprayed out from the small craters, fist-sized to cart-sized. None of them has had time to soften."
        }
      }
    },
