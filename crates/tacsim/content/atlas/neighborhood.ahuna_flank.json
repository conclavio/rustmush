    "room.pad": {
      "kind": "room",
      "def": {
        "name": "Ahuna Flank Pad",
        "short_desc": "A cleared landing square on the lower slope of Ahuna Mons, the mountain's bright streaks rising to the north.",
        "desc": "The pad is cut into the slope and levelled with fused regolith, tie-down rings around its edge and the Registry number FR-22 painted in its middle. Uphill to the north the flank of Ahuna Mons climbs steeply, streaked with bright salt that runs down its sides in long fingers. Downhill the ground breaks into blocks and rubble the mountain has shed. The light off the streaks is hard and white. The horizon to the south is close and stony.",
        "surface": "ground",
        "footprint": {
          "rect": [
            [
              1260,
              1260
            ],
            [
              1300,
              1300
            ]
          ]
        },
        "kind": "outdoor",
        "markers": [
          "port.dock"
        ],
        "details": {
          "bright streaks": "Salt and ice brought up from below and left on the slope. In low sun they shine like wet paint.",
          "rubble": "Blocks shed from the mountain's flank, some the size of a cart. The Registry's survey marks the safe lanes between them with orange paint."
        }
      }
    },
