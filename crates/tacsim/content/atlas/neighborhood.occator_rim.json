    "room.pad": {
      "kind": "room",
      "def": {
        "name": "Occator Rim Pad",
        "short_desc": "A cleared landing square on the northern rim of Occator, the crater falling away to the south.",
        "desc": "The pad is cut into the rim crest and levelled, tie-down rings around its edge and the Registry number FR-07 painted at its corners. Occator Water & Propellant's boundary posts stand on four sides of it, each with the company's blue band. To the south the ground drops away into the crater, its floor grey and wide, the bright faculae at its centre always in view, white against the grey. North of the crest the rim slopes off into broken ground under a close horizon.",
        "surface": "ground",
        "footprint": {
          "rect": [
            [
              1260,
              1260
            ],
            [
              1300,
              1300
            ]
          ]
        },
        "kind": "outdoor",
        "markers": [
          "port.dock"
        ],
        "details": {
          "boundary posts": "Steel posts with a blue band and a claim plate: the holder's name, the block letters and the tenure date. The plates are bolted, not painted.",
          "faculae": "The bright deposits at the crater's centre, where the Freeport stands. From the rim they are a white smear on the grey."
        }
      }
    },
