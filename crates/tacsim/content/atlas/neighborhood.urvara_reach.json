    "room.pad": {
      "kind": "room",
      "def": {
        "name": "Urvara Reach Pad",
        "short_desc": "A cleared landing square on a rock bench of Urvara's floor, the basin's central ridge low on the northern horizon.",
        "desc": "The pad is levelled into a bench of dark rock and edged with tie-down rings, the Registry number FR-31 painted in its middle. The benches step down to the south toward a pale plain where ice lies close under the regolith. To the north the ridge at the middle of Urvara stands up out of the floor, a long grey line against black sky. The survey stakes run out of sight in every direction: this claim is twice as wide as a standard Registry site.",
        "surface": "ground",
        "footprint": {
          "rect": [
            [
              2540,
              2540
            ],
            [
              2580,
              2580
            ]
          ]
        },
        "kind": "outdoor",
        "markers": [
          "port.dock"
        ],
        "details": {
          "survey stakes": "Orange-capped stakes at every block corner, sixteen blocks of 1,280 m, the Registry's first double-span survey on Ceres.",
          "benches": "Steps of dark rock a few metres high, the floor of the basin broken as it settled. The ice-cut plain below them is softer going."
        }
      }
    },
