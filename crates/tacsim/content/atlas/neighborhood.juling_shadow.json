    "room.pad": {
      "kind": "room",
      "def": {
        "name": "Juling Shadow Pad",
        "short_desc": "A cleared landing square in the long shadow of Juling's crater wall, the ground frozen and glittering.",
        "desc": "The pad sits in shadow most of the day, a cleared square with tie-down rings and the Registry number FR-31 painted on in heat-safe orange. Ice lies in the open here: the ground around the square glitters where lamps catch it, and frost rims every rut. To the north the wall of Juling rises dark and steep between the pad and the low sun, and the pad sits at its foot. The cold is the first thing the hull's sensors log. The horizon to the south is low and grey.",
        "surface": "ground",
        "footprint": {
          "rect": [
            [
              1260,
              1260
            ],
            [
              1300,
              1300
            ]
          ]
        },
        "kind": "outdoor",
        "markers": [
          "port.dock"
        ],
        "details": {
          "frost": "A thin white crust on the shaded faces of every stone. It sublimes in a lamp's beam and comes back when the lamp moves on.",
          "crater wall": "Juling's north wall, dark and layered, its upper edge lit while its foot stays in shadow."
        }
      }
    },
