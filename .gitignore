# SSH keys — never commit
hostinger
hostinger.pub
*.pem
id_*

# Rust
/target/
**/*.rs.bk

# Node / web client
node_modules/
web/dist/
# Doc 21 cut G.3b: built by web/scripts/build-wasm.mjs from crates/mush-pixel-wasm
web/src/lib/pixel/mush_pixel.wasm
# Doc 31 cut UD.1: copied by the same script from crates/mush-pixel/models/
web/src/lib/pixel/models/
# Doc 31 cut UD.2: copied by the same script (the designer's catalogue)
web/src/lib/designer/content/
# Doc 43 cut TS.9: the browser smoke's traces, screenshots and HTML report
web/test-results/
web/playwright-report/

# Secrets & local config
.env
.env.*
mushd.local.toml
mush-bot.local.toml

# Runtime data
/data/
*.rdb
*.aof
logs/
.mush-bot/

# OS noise
Thumbs.db
.DS_Store

# Local run config (ids, ports); the tracked ones live under deploy/ and mushd.toml.example
/mushd.toml

# The TacSim harness's reports, written at the root by scripts/harness-weekly.sh and
# the CI job (16b cut U.3); the committed baselines live under
# crates/tacsim/tests/harness_baseline/
/harness*.json

# The surface-mining cost lane's report, written at the root by scripts/cost-lane.sh (doc 20 cut
# SM.12c-lane)
/cost-lane*.json

# Python bytecode caches (a guard test of scripts/prune_target.py left one under scripts/ on 2026-09-28)
__pycache__/
*.pyc

# Unity 3D client (unity/) — cache, build artifacts, IDE files, and commercial 3D asset packs.
# Per the 2026-10-29 licensing ruling (doc 22 / doc 30), third-party .unitypackage / .fbx /
# textures imported from 3d_assets must never be committed: only unity/Assets/_TacSim/ is tracked.
unity/[Ll]ibrary/
unity/[Tt]emp/
unity/[Oo]bj/
unity/[Bb]uild/
unity/[Bb]uilds/
unity/[Ll]ogs/
unity/[Uu]serSettings/
unity/[Mm]emoryCaptures/
unity/[Rr]ecordings/
unity/.vs/
unity/.vsconfig
unity/*.csproj
unity/*.sln
unity/*.slnx
unity/*.unityproj
unity/*.pidb
unity/*.booproj
unity/*.svd
unity/*.pdb
unity/*.mdb
unity/*.opendb
unity/*.VC.db
unity/sysinfo.txt
unity/crashlytics-build.properties
unity/Assets/*
!unity/Assets/_TacSim/
!unity/Assets/_TacSim.meta
# Generated local scene & commercial prefab GUID catalog (rebuilt via TacSim -> 1 & 2 menus)
unity/Assets/_TacSim/Scenes/
unity/Assets/_TacSim/Scenes.meta
unity/Assets/_TacSim/Resources/
unity/Assets/_TacSim/Resources.meta
